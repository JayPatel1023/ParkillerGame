# Copy this file to .env.local (already gitignored via *.local) and fill in real values.
# Never commit .env.local - it holds your real Photon App ID.

# Photon Realtime App ID (milestone 2, online play) - get one at https://dashboard.photonengine.com/
# Dashboard -> Create a New App -> Photon Type: "Realtime" -> copy the App ID it generates.
VITE_PHOTON_APP_ID=
